# Meridian — Environment Variables
# Copy to .env and fill in values

# PostgreSQL
POSTGRES_USER=meridian
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=meridian
DATABASE_URL=postgresql://meridian:change_me_in_production@postgres:5432/meridian

# Redis
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@redis:6379/0

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_DOCUMENTS=meridian.documents
KAFKA_TOPIC_TRACES=meridian.traces
KAFKA_TOPIC_EVALUATIONS=meridian.evaluations
KAFKA_TOPIC_DLQ=meridian.dlq

# LLM Providers (add keys for providers you want to use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_JUDGE_MODEL=llama3.1:8b

# Gateway
GATEWAY_PORT=8080
GATEWAY_ADMIN_PORT=8081
JWT_SECRET=change_me_in_production

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_in_production

# Evaluation
EVAL_TIER2_SAMPLE_RATE=0.10
EVAL_FEEDBACK_WINDOW_MINUTES=5
EVAL_FEEDBACK_MIN_SAMPLES=50
EVAL_FEEDBACK_MAX_WEIGHT_SHIFT=0.10